# Arafi Interface — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# Base URL for the Ara backend API
VITE_API_BASE_URL=https://ara-be.onrender.com

# Cloudflare Turnstile public site key (safe to expose — this is the public key, not the secret)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADtPlPMkSxl0T5Fh
